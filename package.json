{
  "name": "meyar-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Meyar (معيار) Culinary Social Network & B2B Supplies Marketplace",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "dev:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "build:js": "esbuild js/main.js --bundle --outfile=js/bundle.js --format=iife --target=es2020",
    "build": "npm run build:css && npm run build:js",
    "test": "node --test tests/*.test.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch server/server.js",
    "start": "node server/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "esbuild": "^0.28.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
